ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=meditrack;Username=meditrack;Password=change-this-password
Jwt__Key=replace-with-a-secret-key-at-least-32-characters
